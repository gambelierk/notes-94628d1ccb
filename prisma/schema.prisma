// Prisma-schema för föreningsbutiken.
// Kör `npx prisma migrate dev --name init` (utveckling) eller
// `npx prisma db push` för att skapa tabellerna.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Enskilt adminkonto (seedas via `npm run seed`).
model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  /// Pris i öre, t.ex. 24900 = 249,00 kr
  priceOre    Int
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  variants    Variant[]
  images      ProductImage[]
  orderItems  OrderItem[]

  @@index([active, sortOrder])
}

/// En produktbild. En produkt kan ha flera bilder; den med lägst sortOrder är huvudbilden
/// och visas i produktrutnätet, i varukorgen och i mejlen.
model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// Antingen en URL (https://...) eller en data-URL (base64) som sparas i databasen.
  url       String
  /// Ursprungligt filnamn, t.ex. "tshirt_svart_001.jpg". Används för sortering och i admin.
  filename  String?
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

/// En kombination av storlek och färg med eget lagersaldo.
model Variant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String
  stock     Int     @default(0)

  orderItems OrderItem[]

  @@unique([productId, size, color])
  @@index([productId])
}

enum OrderStatus {
  awaiting_payment
  payment_claimed
  paid
  picked_up
}

model Order {
  id              String      @id @default(cuid())
  /// Kort referenskod som kunden uppger vid upphämtning, t.ex. "K7QF2M".
  reference       String      @unique
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String?
  status          OrderStatus @default(payment_claimed)
  /// Ordersumma i öre vid beställningstillfället.
  totalOre        Int
  /// True när lagersaldot har dragits (sker först vid status "paid").
  stockAdjusted   Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([createdAt])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Variant/produkt kan ha tagits bort senare – därför sparas namn och pris som text/tal här.
  variantId   String?
  variant     Variant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  size        String
  color       String
  quantity    Int
  /// Styckpris i öre vid beställningstillfället.
  unitPriceOre Int

  @@index([orderId])
}
