# ---------------------------------------------------------------------------
# Kopiera den här filen till .env och fyll i värdena.
# Samma variabler används både lokalt, på Render och på Netlify.
# ---------------------------------------------------------------------------

# Postgres-anslutning. Fungerar med Render Postgres, Neon och Supabase.
# Render:   postgresql://user:losenord@host/dbnamn
# Neon:     postgresql://user:losenord@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Supabase: postgresql://postgres:losenord@db.xxx.supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foreningsbutik"

# Hemlighet som signerar admin-inloggningens cookie.
# Generera en ny med: openssl rand -base64 32
SESSION_SECRET="byt-ut-mig-till-en-lang-slumpmassig-strang"

# Adminkontot som skapas av `npm run seed`.
ADMIN_EMAIL="admin@dinforening.se"
ADMIN_PASSWORD="byt-losenord-direkt"

# ---------------------------------------------------------------------------
# E-post (Resend – https://resend.com)
# Utan RESEND_API_KEY skickas inga riktiga mejl; innehållet loggas i konsolen
# i stället, så att du kan utveckla lokalt utan e-postkonto.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
# Avsändaradress. Måste tillhöra en domän som är verifierad i Resend.
EMAIL_FROM="Föreningens butik <butik@dinforening.se>"
# Föreningens inkorg som får en avisering vid varje ny beställning.
ORDER_NOTIFICATION_EMAIL="bestallningar@dinforening.se"
