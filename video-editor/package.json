{
  "name": "video-editor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @ve/server --filter @ve/editor dev",
    "build": "pnpm --filter @ve/editor build",
    "start": "pnpm --filter @ve/server start",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/server/tsconfig.json",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs && node scripts/e2e-admin.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
